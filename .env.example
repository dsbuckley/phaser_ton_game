# Client-side environment (Vite inlines VITE_* into the public bundle —
# never put secrets here; server secrets live in .dev.vars / wrangler secrets)

# Adsgram rewarded-ads block id (from adsgram.ai) — optional; without it
# the Earn tab's Watch Ad and the wheel's free spins use a dev mock.
VITE_ADSGRAM_BLOCK_ID=

# NOTE: VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are NO LONGER USED.
# The browser never talks to Supabase — everything goes through the
# Cloudflare Worker (see server/ and DEPLOYMENT.md).
