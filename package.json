{
  "name": "phaser-telegram-ton-boilerplate",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wrangler dev --port 8787\"",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p server/tsconfig.json",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@tonconnect/ui": "^2.3.1",
    "hono": "^4.12.30",
    "phaser": "^3.90.0",
    "vite-plugin-node-polyfills": "^0.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260718.1",
    "concurrently": "^10.0.3",
    "typescript": "^7.0.2",
    "vite": "^5.0.0",
    "wrangler": "^4.112.0"
  }
}
