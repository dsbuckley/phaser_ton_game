{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:client"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "worker",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "exec npx wrangler dev --port \"${PORT:-8787}\""],
      "port": 8787,
      "autoPort": true
    }
  ]
}
